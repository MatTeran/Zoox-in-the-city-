{
  "name": "zoox-future-sf",
  "version": "0.1.0",
  "private": true,
  "description": "ZOOX FUTURE SF — neon San Francisco robotaxi arcade game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "expo": "npm --prefix expo-app start",
    "expo:android": "npm --prefix expo-app run android",
    "expo:ios": "npm --prefix expo-app run ios",
    "expo:web": "npm --prefix expo-app run web",
    "sync:expo-web": "npm run build && node scripts/sync-expo-web.mjs"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "vite": "^6.0.7"
  }
}
